{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "leos-cutz",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
